<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.dashi-plugin.channel-<agent></string>
    <key>ProgramArguments</key>
    <array><string><wrapper></string></array>
    <key>WorkingDirectory</key>
    <string><plugin-dir></string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key><string><home></string>
        <key>PATH</key><string><path></string>
    </dict>
    <!-- LaunchAgent starts at user login after bootstrap; no root required. -->
    <key>RunAtLoad</key><true/>
    <!-- Wrapper exits 1 on session loss, 0 on operator TERM/INT. -->
    <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
    <key>ThrottleInterval</key><integer>15</integer>
    <key>ExitTimeOut</key><integer>30</integer>
    <key>StandardOutPath</key><string><state-dir>/channel.out.log</string>
    <key>StandardErrorPath</key><string><state-dir>/channel.err.log</string>
    <key>ProcessType</key><string>Interactive</string>
</dict>
</plist>
