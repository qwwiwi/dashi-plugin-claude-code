[Unit]
Description=Dashi Plugin Channel for <agent>
After=network-online.target
Wants=network-online.target

[Service]
# Install as the unprivileged account that owns the Claude login.
User=<service-user>
WorkingDirectory=<plugin-dir>
Environment="HOME=<home>"
Environment="PATH=<path>"
# Foreground wrapper tracks the tmux session; detached tmux alone cannot
# report Claude exits to systemd. Secrets are sourced only by the wrapper.
Type=simple
ExecStart=<wrapper>
Restart=on-failure
RestartSec=15s
TimeoutStopSec=30s

[Install]
WantedBy=multi-user.target
